# === MEDFLOW ENVIRONMENT VARIABLES ===
# Copy this to .env and fill with real values
# NEVER commit .env to git

# --- Snowflake ---
SNOWFLAKE_ACCOUNT=your_account_identifier_here
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=MEDFLOW_WH
SNOWFLAKE_DATABASE=MEDFLOW

# --- MotherDuck (Snowflake fallback) ---
MOTHERDUCK_TOKEN=your_token_here

# --- Data Paths ---
SYNTHEA_DATA_PATH=./data/raw/synthea

# --- Target (snowflake or duckdb) ---
DBT_TARGET=snowflake